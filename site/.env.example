# NovaCMS — variables d'environnement (à configurer sur Vercel + en local pour `vercel dev`)
# Aucune ne doit être préfixée VITE_ — toutes sont consommées côté serveur uniquement.

# Hash bcrypt du mot de passe admin.
# Génération : node -e "console.log(require('bcryptjs').hashSync('TON_MOT_DE_PASSE', 12))"
ADMIN_PASSWORD_HASH=

# Secret aléatoire >=32 octets pour signer le JWT de session.
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Personal Access Token GitHub (fine-grained), scope: Contents read+write sur le repo cible uniquement.
GITHUB_TOKEN=

# Cible du commit
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BRANCH=main

# Chemin du fichier de contenu dans le repo
CONTENT_PATH=public/content.json
