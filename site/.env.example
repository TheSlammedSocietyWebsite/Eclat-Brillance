# NovaCMS — Variables d'environnement pour Vercel (Edge Functions)
# À configurer dans les paramètres Vercel du projet (et dans .env.local en dev local)

# Hash PBKDF2 du mot de passe admin
ADMIN_PASSWORD_HASH=

# Secret pour la signature du JWT de session (ex: chaîne aléatoire 32+ caractères)
SESSION_SECRET=

# Personal Access Token GitHub (scope: Contents read/write)
GITHUB_TOKEN=

# Dépôt GitHub cible pour la sauvegarde du CMS
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BRANCH=master
CONTENT_PATH=site/public/content.json

# (Optionnel) Upstash Redis pour rate limiting et persistance
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
