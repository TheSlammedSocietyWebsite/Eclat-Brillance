# NovaCMS — variables d'environnement (à configurer sur Vercel + en local pour `vercel dev`)
# Aucune ne doit être préfixée VITE_ — toutes sont consommées côté serveur uniquement.

# Hash du mot de passe admin (PBKDF2 via Web Crypto API — compatible Vercel Edge).
# Génération : node -e "
#   const { hashPassword } = require('./api/_lib/crypto.js');
#   hashPassword('TON_MOT_DE_PASSE').then(h => console.log(h));
# "
ADMIN_PASSWORD_HASH=

# Secret aléatoire >=32 octets pour signer le JWT de session.
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Personal Access Token GitHub (fine-grained), scope: Contents read+write sur le repo cible uniquement.
GITHUB_TOKEN=

# Cible du commit
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BRANCH=master

# Chemin du fichier de contenu dans le repo (ajuster si le site est dans un sous-dossier)
CONTENT_PATH=site/public/content.json
